# DealMind environment template
# Copy to `.env` (project root) and fill in your own keys. Never commit the real .env.
#
#   cp .env.example .env
#
# NOTE: keys previously listed in this file were real credentials. They have been
# removed from the template — if they were ever shared, rotate them:
#   Hindsight: https://ui.hindsight.vectorize.io  -> Settings -> API Keys
#   Groq:      https://console.groq.com/keys

# Hindsight Cloud API key (starts with hsk_)
HINDSIGHT_API_KEY=hsk_replace_me

# Groq API key (starts with gsk_)
GROQ_API_KEY=gsk_replace_me

# Optional: custom endpoints
HINDSIGHT_URL=https://api.hindsight.vectorize.io
LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional: overrides
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/dealmind
LLM_MODEL=openai/gpt-oss-120b
